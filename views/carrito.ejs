<%- include("partials/header") %>

<h1>Carrito de compras</h1>
<table border="1">
  <tr>
    <th>Producto</th>
    <th>Detalle</th>
    <th>Precio</th>
    <th>Stock</th>
  </tr>

<% carrito.forEach(item => { %>
<tr>
  <td><img src="<%= item.producto.imagen %>" width="150"></td>
  

  <p>
    <td> <%= item.producto.nombre %>  </td>
 
    
<td>     <form action="/carrito/restar/<%= item.producto.id %>" method="POST" style="display:inline;">
      <button type="submit">➖</button>
    </form>

    <!-- CANTIDAD -->
    Cantidad: <%= item.cantidad %>

    <!-- SUMAR -->
    <form action="/carrito/sumar/<%= item.producto.id %>" method="POST" style="display:inline;">
      <button type="submit">➕</button>
    </form>

    <!-- ELIMINAR -->
    <form action="/carrito/<%= item.producto.id %>?_method=DELETE" method="POST" style="display:inline;">
      <button type="submit">🗑</button>
    </form> </td>
    <!-- RESTAR -->
  <td> $<%= item.producto.precio %> </td>

  </p>
</tr>
<% }) %>
  <tr>
    <td colspan="3" style="text-align:right"><h2> <strong>Total</strong></h2></td>
    <td  style="text-align:right"><strong> <h2>$<%= total %></h2> </strong></td>
  </tr>

</table>
<%- include("partials/footer") %>



