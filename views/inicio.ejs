<%- include("partials/header") %>

<h1>Bienvenido a mi sitio</h1>
<p>Esta es la página de inicio</p>

<h1>Productos</h1>

<form action="/carrito" method="POST">
  <% productos.forEach(producto => { %>
    <div>
      <h2><%= producto.nombre %></h2>
      <p>$<%= producto.precio %></p>


       <a href="/producto/<%=producto.id%>">

        <img src="<%= producto.imagen %>" width="150">
       </a>
      

      <!-- Checkbox para seleccionar producto -->
      <input type="checkbox" name="productos[]" value="<%= producto.id %>">
      <label>Agregar al carrito</label>
    </div>
  <% }) %>

  <button type="submit">Agregar seleccionados al carrito</button>
</form>

<%- include("partials/footer") %>





 










